# Copy to .env for local development:  cp .env.example .env

# Local SQLite database file (Prisma)
DATABASE_URL="file:./dev.db"

# Secret used to sign the session cookie (HMAC). Use any long random string.
# Generate one with:  openssl rand -hex 32
SESSION_SECRET="dev-only-change-me-to-a-long-random-string"
