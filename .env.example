# Copy to .env for local development:  cp .env.example .env

# PostgreSQL connection string.
# Local dev + production both use a (free) Neon Postgres database — paste the
# connection string Neon gives you here. Example shape:
# postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# Secret used to sign the session cookie (HMAC). Use a long random string.
# Generate one with:  openssl rand -hex 32
SESSION_SECRET="change-me-to-a-long-random-string"
