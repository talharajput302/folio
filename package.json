{
  "name": "ajaia-docs",
  "version": "1.0.0",
  "private": true,
  "description": "Lightweight collaborative document editor (Google Docs-inspired slice).",
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "vercel-build": "prisma generate && prisma db push --skip-generate && next build",
